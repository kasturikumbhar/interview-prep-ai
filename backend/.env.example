APP_NAME=Interview Prep AI
DEBUG=false
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://localhost:11434

# Generation model
# 16GB RAM → qwen2.5-coder:7b
# 32GB RAM → qwen3:14b  (recommended upgrade)
# 48GB+    → qwen3:32b
DEFAULT_MODEL=qwen2.5-coder:7b

# Embedding model — mxbai-embed-large beats nomic-embed-text on MTEB retrieval
# Pull: ollama pull mxbai-embed-large
EMBED_MODEL=mxbai-embed-large

# Storage
CHROMA_PERSIST_DIR=./data/chroma
DATA_DIR=./data
NOTES_DIR=./data/notes
SESSIONS_DIR=./data/sessions

# Retrieval
DEFAULT_RETRIEVAL_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=80

CORS_ORIGINS=["http://localhost:3000"]
