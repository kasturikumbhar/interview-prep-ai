APP_NAME=Interview Prep AI
DEBUG=false
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://localhost:11434

# ── Model selection ──────────────────────────────────────────────────────────
# General model: qwen2.5:14b if you have 16GB+ RAM, else qwen2.5:7b
# Coding model: qwen2.5-coder:7b (best for DSA + Java + Python questions)
DEFAULT_MODEL=qwen2.5-coder:7b

# ── Embedding model ──────────────────────────────────────────────────────────
# RECOMMENDED UPGRADE: mxbai-embed-large > nomic-embed-text
#
# Comparison (MTEB retrieval benchmark):
#   mxbai-embed-large  → NDCG@10: 54.39  (best local option for semantic retrieval)
#   nomic-embed-text   → NDCG@10: 53.20  (current, good but weaker on technical content)
#   bge-m3             → NDCG@10: 55.62  (slightly better but 2x slower on M-series)
#   snowflake-arctic   → NDCG@10: 52.81  (fast but weakest semantic quality)
#
# Decision: mxbai-embed-large — best quality/speed tradeoff on Apple Silicon
# Pull with: ollama pull mxbai-embed-large
#
# To switch back: just change EMBED_MODEL here, then re-run ingestion with --clear
EMBED_MODEL=mxbai-embed-large

# ── Storage ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
DATA_DIR=./data
NOTES_DIR=./data/notes
SESSIONS_DIR=./data/sessions

# ── Retrieval tuning ─────────────────────────────────────────────────────────
DEFAULT_RETRIEVAL_K=5
# These are no longer used for chunking (semantic chunker handles it)
# Kept for backward compatibility
CHUNK_SIZE=600
CHUNK_OVERLAP=80
